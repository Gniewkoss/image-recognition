{
  "name": "image-recognition-app",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "backend": "./backend/venv/bin/python backend/server.py",
    "backend:stop": "sh -c 'for pid in $(lsof -ti tcp:5001 2>/dev/null); do kill -9 $pid 2>/dev/null; done; exit 0'",
    "kill-metro": "sh -c 'for p in 8081 8082; do for pid in $(lsof -ti tcp:$p 2>/dev/null); do kill -9 $pid 2>/dev/null; done; done; exit 0'",
    "prestart": "npm run kill-metro",
    "start": "expo start --clear --port 8081 --lan",
    "prestart:lan": "npm run kill-metro",
    "start:lan": "expo start --lan --clear --port 8081",
    "prestart:tunnel": "npm run kill-metro",
    "start:tunnel": "expo start --tunnel --clear --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "babel-preset-expo": "~54.0.10",
    "expo": "^54.0.0",
    "expo-asset": "~12.0.12",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "^55.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0"
  },
  "private": true
}
